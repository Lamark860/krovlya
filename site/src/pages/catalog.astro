---
/**
 * Каталог напольных покрытий. Вся механика — в `CatalogBrowser.astro`,
 * здесь только тексты направления: заголовок, оффер и адрес квиза.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import QuickForm from "../components/QuickForm.astro";
import CatalogBrowser from "../components/CatalogBrowser.astro";
---

<Base
  title="Каталог ламината и кварцвинила в Ижевске — «Мой ремонт»"
  description="2 316 напольных покрытий в наличии и под заказ: ламинат, кварцвинил, SPC. Укладка в подарок при заказе от 30 м²."
>
  <Header cta="/poly#lead" />

  <main>
    <CatalogBrowser
      src="/data/catalog-poly.json"
      eyebrow="ламинат · кварцвинил · SPC"
      title="Выберите напольное покрытие"
      accent="и получите укладку в подарок"
      lead="Укладка напольных покрытий в подарок при заказе от 30 м². Замер, расчёт и консультация — бесплатно."
      subLabel="класс и формат"
      quiz="/poly#quiz"
      quizTitle="Не хотите листать каталог?"
      quizLead="Ответьте на пять вопросов — покажем подходящие покрытия и посчитаем стоимость пола вместе с работой. Контакты для расчёта не нужны."
    />
  </main>

  <Footer />
  <QuickForm />
</Base>
