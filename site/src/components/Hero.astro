---
/**
 * Обложка. По ТЗ (п. 1): затемнённое фото на весь экран — ровно один экран
 * и на компе, и на телефоне.
 *
 * Высоту считаем в `svh`, а не `vh`: на телефоне `100vh` больше видимой области
 * на высоту адресной строки, и нижний край обложки уезжает под неё. Шапка липкая,
 * поэтому её высоту вычитаем — иначе «один экран» получается с прокруткой.
 *
 * Фото — `/img/cover-floor.webp`, лежит у нас. Источник и ответственность
 * за использование — решение заказчика от 14.08, вопрос 26 в 12_TZ_PRAVKI.md.
 */
import { company } from "../data/company";

interface Props {
  eyebrow: string;
  title: string;
  titleTail: string;
  lead: string;
  gift: string;
  facts: { value: string; label: string }[];
  cover?: string;
}

const {
  eyebrow, title, titleTail, lead, gift, facts,
  cover = "/img/cover-floor.webp",
} = Astro.props;
---

<section class="hero on-dark">
  <img class="hero__bg" src={cover} alt="" fetchpriority="high" width="2000" height="1500" />

  <div class="layout hero__layout">
    <div class="hero__text">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title} <span data-geo>{company.geo.cities[company.geo.default].phrase}</span> {titleTail}</h1>
      <p class="lead hero__lead">{lead}</p>

      <div class="hero__actions">
        <a class="btn" href="#quiz">Рассчитать стоимость — 2 минуты</a>
        <a class="btn btn--ghost" href="#lead">Записаться на замер</a>
      </div>

      <p class="gift hero__gift">{gift}</p>
    </div>

    <dl class="hero__facts">
      {facts.map((fact) => (
        <div class="hero__fact">
          <dt class="hero__fact-value num">{fact.value}</dt>
          <dd class="hero__fact-label">{fact.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    /* Одна строка на всю высоту: тогда раскладка внутри может развести
       текст и цифры по краям экрана, а не собрать их в середине. */
    grid-auto-rows: 1fr;
    padding-block: var(--s-8);
    overflow: hidden;
  }

  /* Фото отдельным <img>, а не background-image: так браузер грузит его
     с высоким приоритетом и учитывает в LCP, а не откладывает до разбора CSS. */
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Затемнение по ТЗ. Градиент, а не ровная заливка: текст слева должен
     читаться, а правая часть фотографии — оставаться фотографией. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgb(9 37 50 / 0.92) 0%, rgb(9 37 50 / 0.78) 45%, rgb(9 37 50 / 0.45) 100%);
    z-index: 0;
  }

  .hero__layout {
    position: relative;
    z-index: 1;
    align-content: space-between;
    row-gap: var(--s-8);
  }

  .hero__text {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    align-items: flex-start;
  }

  .hero__text h1 { max-width: 18ch; }
  .hero__lead { max-width: 46ch; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }

  .hero__gift { margin-top: var(--s-1); }

  .hero__facts {
    grid-column: span 12;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4) var(--s-2);
    margin: 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .hero__fact-value { font-size: 1.5rem; font-weight: 500; line-height: 1.1; }
  .hero__fact-label { font-size: var(--t-small); color: var(--ink-2); margin: 2px 0 0; }

  @media (min-width: 720px) {
    .hero__facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .hero { padding-block: var(--s-8) var(--s-6); }
    .hero__text { grid-column: span 8; }
  }
</style>
