# Что уходит в публичный репозиторий Lamark860/krovlya, а что нет.
#
# Правило простое: в git — только то, из чего собирается и разворачивается сайт.
# Всё «наше внутреннее» (аналитика, переписка, документы заказчика, доступы)
# живёт ТОЛЬКО на рабочей машине. Репозиторий публичный — исходим из того,
# что каждый закоммиченный файл прочитает посторонний.

.DS_Store
node_modules/

# --- Внутреннее: не для публичного репозитория -------------------------------
# Рабочие документы: открытые вопросы «не заказчику», профиль каталога с ценами
# и наценками, маркетинговые заготовки, дословная переписка в inbox/.
_local_docs/

# Файлы от заказчика как есть: бриф, реквизиты, выгрузка каталога.
docs/

# Навигация по внутренним документам — называет ИП/ООО заказчика и его админку.
CLAUDE.md

# Гигабайты исходников и материалов курса.
big_folders/

# --- Секреты -----------------------------------------------------------------
*.local.md
.env
.env.*
!.env.example

# --- Артефакты ---------------------------------------------------------------
# Пересоздаются пайплайном из выгрузки; заодно сюда монтируются заявки
# и PDF лид-магнитов на сервере (data/leads, data/files).
# Слэш в начале обязателен: без него правило съедает и site/src/data,
# и site/public/data — а там витрина и данные квиза, без них сборка пустая.
/data/

# Рабочие скриншоты проверок вёрстки.
site/screenshots/

# Настоящий конфиг приёма заявок: пароль от базы, токен бота, адрес получателя.
# Живёт на сервере вне webroot; если случайно окажется здесь — в публичный репозиторий
# он уйти не должен. В git ходит только config.example.php.
api-php/config.php
