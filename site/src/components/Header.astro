---
import { company } from "../data/company";

interface Props {
  /**
   * Куда ведёт кнопка в шапке. По умолчанию — на форму посадочной, потому что
   * форма есть только там: на «Спасибо», в политиках и на 404 якорь #lead
   * никуда не вёл, и кнопка молча не работала.
   */
  cta?: string;
  /**
   * Каталог своего направления: с плиточных страниц вести на каталог полов —
   * значит терять человека, который пришёл за плиткой. По умолчанию — полы,
   * потому что на служебных страницах (404, политики) направления нет.
   */
  catalog?: string;
}

const { cta = "/poly#lead", catalog = "/catalog" } = Astro.props;
---

<header class="header">
  <div class="header__inner">
    <a class="header__brand" href="/">
      <span class="header__mark" aria-hidden="true"></span>
      {company.brand}
    </a>

    <div class="header__contacts">
      {/* Каталог в меню — правка Артура от 02.09. Ссылка, а не кнопка: рядом уже
          стоит кнопка консультации, две кнопки подряд спорят друг с другом. */}
      <a class="header__nav" href={catalog}
         data-analytics="cta" data-cta-id="header_catalog"
         data-placement="header" data-target="catalog">Каталог</a>
      <span class="header__showroom muted">{company.showroom.address}</span>
      <a class="header__phone" href={`tel:${company.phoneHref}`}
         data-analytics="phone" data-placement="header">{company.phone}</a>
      {/* Было «Бесплатный замер». По правке п. 5 замер уходит с кнопок,
          но «бесплатно» в шапке терять жалко — оно и есть повод нажать. */}
      <a class="btn btn--ghost header__cta" href={cta}
         data-analytics="cta" data-cta-id="header_consult"
         data-placement="header" data-target="form">Бесплатная консультация</a>
    </div>
  </div>
</header>

<style>
  .header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    /* Высота шапки нужна обложке: она занимает ровно один экран за вычетом шапки.
       Держим её здесь, чтобы значение не разъехалось с реальным padding. */
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header__inner {
    max-width: var(--page);
    margin-inline: auto;
    padding: var(--s-2) var(--s-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    /* Без nowrap «Мой ремонт» переносится на две строки, как только рядом
       появился «Каталог», и шапка на мобиле вырастает с 53 до 81 px. */
    white-space: nowrap;
    gap: var(--s-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  /* Марка — четыре плитки со швом: та же раскладка, что и вся страница */
  .header__mark {
    width: 22px;
    height: 22px;
    background:
      linear-gradient(var(--ink), var(--ink)) 0 0 / 10px 10px no-repeat,
      linear-gradient(var(--ink), var(--ink)) 12px 0 / 10px 10px no-repeat,
      linear-gradient(var(--ink), var(--ink)) 0 12px / 10px 10px no-repeat,
      linear-gradient(var(--accent), var(--accent)) 12px 12px / 10px 10px no-repeat;
  }

  .header__contacts {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .header__phone {
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__showroom { font-size: var(--t-small); }

  .header__nav {
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav:hover { color: var(--accent); }

  @media (max-width: 899px) {
    .header__showroom { display: none; }
  }

  @media (max-width: 639px) {
    .header__cta { display: none; }
    .header__inner { padding-inline: var(--s-2); }
    /* Марка, «Каталог» и телефон в одну строку помещаются только ужатыми.
       Ужимаем, а не прячем: телефон в шапке — это клик по `tel:` и цель
       `phone_click`, а «Каталог» — единственная навигация на странице. */
    .header__nav,
    .header__phone { font-size: var(--t-small); }
    .header__contacts { gap: var(--s-2); }
  }

  /* 360 px — самый узкий экран, который ещё встречается. На нём три элемента
     в 14 px не сходятся: телефон вылезает за край. Замерено, не на глаз. */
  @media (max-width: 479px) {
    .header__brand { font-size: 1rem; }
    .header__nav,
    .header__phone { font-size: var(--t-micro); }
    .header__contacts { gap: var(--s-1); }
  }
</style>
