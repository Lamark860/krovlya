---
/**
 * Отдельная страница квиза по напольным покрытиям. Правка Артура от 02.09:
 * «квизы скопируй и вынеси на отдельные страницы».
 *
 * Копии кода при этом нет: страница собирает тот же `Quiz.astro` с теми же
 * пропсами, что и посадочная. Скопировать компонент значило бы завести вторую
 * формулу расчёта, которая разъедется с первой на первой же правке цен.
 *
 * Зачем страница нужна: под объявление, которое ведёт сразу на расчёт.
 * На посадочной квиз стоит четвёртой секцией, и человек с рекламы до него
 * доскроллит не всегда. Здесь он и есть страница — поэтому заголовок квиза
 * тут `h1`, а не `h2`.
 *
 * Аналитика едет сама: `quiz_id` берётся из `data-direction`, а `service`
 * в целях — из адреса (`serviceOf()` в analytics.ts). Правя адрес страницы,
 * помнить: «plitka» в пути — это признак направления.
 *
 * Ниже квиза оставлены форма консультации и контакты: человеку, который
 * считать не захотел, должно быть куда деться, кроме кнопки «назад».
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Quiz from "../components/Quiz.astro";
import Consult from "../components/Consult.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import QuickForm from "../components/QuickForm.astro";
---

<Base
  title="Расчёт стоимости пола за 2 минуты — «Мой ремонт», Ижевск"
  description="Ответьте на 5 вопросов и узнайте стоимость ламината или кварцвинила вместе с укладкой. Цену покажем сразу на экране, без звонка и без контактов."
>
  <Header cta="#lead" catalog="/catalog" />

  <main>
    <Quiz
      direction="poly"
      level="h1"
      title="Рассчитайте стоимость пола"
      accent="и получите укладку в подарок"
      personNote="Считаем материал по ценам каталога, а не «в среднем по рынку». Если ответ неочевиден — выберите «не знаю», уточним на замере."
    />

    <Consult />

    <Contacts />
  </main>

  <Footer />

  <QuickForm />
</Base>
