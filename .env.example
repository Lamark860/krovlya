# Шаблон окружения для прод-стенда. Реальный .env живёт на сервере и в git не ходит.
# Скопировать: cp .env.example .env

# Адрес, по которому сайт открывается. Печётся в canonical и OG на этапе сборки —
# после смены нужен пересбор образа (up -d --build), рестарта мало.
PUBLIC_SITE_URL=http://5.187.2.81:8104

# 1 — разрешить индексацию. Держим 0, пока это стенд: недоделанный лендинг
# клиента в поисковой выдаче — прямой вред.
PUBLIC_INDEXABLE=0

# Порт на хосте. Проверить занятые: ss -ltn
WEB_PORT=8104

# Домен для перехода на HTTPS через общий Traefik. Пока пусто — блокер Б4.
DOMAIN=

# Уведомления о заявках в Telegram. Пусто — заявки просто копятся в SQLite и в логе.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
