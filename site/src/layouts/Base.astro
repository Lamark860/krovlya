---
import "../styles/tokens.css";
import { company } from "../data/company";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Сборка идёт в format: "file", поэтому pathname здесь — «/poly.html».
// Отдаётся же адрес без расширения, и canonical обязан указывать ровно на него,
// иначе поисковик видит две версии страницы.
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "");
const canonical = new URL(path, Astro.site);

// Стенд закрыт от поиска: недоделанный лендинг клиента в выдаче — прямой вред.
// Открывается одним флагом при выкатке на боевой домен (см. _local_docs/11_DEPLOY.md).
const indexable = import.meta.env.PUBLIC_INDEXABLE === "1";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />

    <!-- Подстановка города до первой отрисовки: иначе заголовок мигает.
         Роботам и при отсутствии параметра — всегда значение по умолчанию. -->
    <script is:inline define:vars={{ geo: company.geo }}>
      (() => {
        const key = new URLSearchParams(location.search).get("city");
        const city = key && geo.cities[key];
        if (!city) return;
        document.documentElement.dataset.city = key;
        addEventListener("DOMContentLoaded", () => {
          // В заголовок — предложный падеж, в заявку — название города.
          document.querySelectorAll("[data-geo]").forEach((el) => (el.textContent = city.phrase));
          document.querySelectorAll("input[name=geo]").forEach((el) => (el.value = city.label));
        });
      })();
    </script>

    <!-- Слот под счётчик Яндекс.Метрики: код Максим пришлёт позже -->
    <!-- METRIKA -->
  </head>
  <body>
    <slot />

    <!-- Слот под виджет чата из amoCRM: подключим, когда решим, нужен ли -->
    <!-- CHAT -->
  </body>
</html>
