---
import showcase from "../data/showcase.json";

interface Props {
  direction: "poly" | "plitka";
}

const { direction } = Astro.props;
const blocks = (showcase as Record<string, any[]>)[direction] ?? [];
const money = (value: number) => value.toLocaleString("ru-RU");
---

<section class="showcase" id="catalog">
  <div class="layout">
    <div class="tile showcase__intro">
      <p class="eyebrow">со склада и под заказ</p>
      <h2>Подборки под задачу</h2>
      <p class="muted">
        Показаны позиции из наличия. Полный каталог — больше двух тысяч покрытий,
        подберём под ваш бюджет на замере.
      </p>
    </div>
  </div>

  {blocks.map((block) => (
    <div class="showcase__block">
      <div class="layout">
        <div class="tile showcase__head">
          <h3>{block.title}</h3>
          <p class="muted">{block.note}</p>
          <p class="showcase__from num">от {money(block.price_from)} <span class="unit">₽/м²</span></p>
          <p><a class="showcase__all" href="https://moiremont18.ru/categories/laminat-1" target="_blank" rel="noopener">Смотреть все позиции →</a></p>
        </div>

        {block.items.map((item: any) => (
          <article class="tile showcase__card">
            <a class="showcase__link" href={item.url} target="_blank" rel="noopener">
              <img src={item.picture} alt={item.name} loading="lazy" width="450" height="450" />
              <h4 class="showcase__name">{item.name}</h4>
            </a>
            <p class="showcase__meta muted">
              {[item.vendor, item.params?.["Класс"] && `${item.params["Класс"]} класс`,
                item.params?.["Толщина, мм"] && `${item.params["Толщина, мм"]} мм`]
                .filter(Boolean).join(" · ")}
            </p>
            <p class="showcase__price num">{money(item.price)} <span class="unit">₽/{item.unit || "м²"}</span></p>
          </article>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .showcase { padding-block: var(--s-4); display: grid; gap: var(--s-8); }
  .showcase__intro { grid-column: span 12; }
  .showcase__head { grid-column: span 12; display: flex; flex-direction: column; gap: var(--s-1); }
  .showcase__from { font-size: var(--t-price); }
  .showcase__all { font-size: var(--t-small); color: var(--accent); text-decoration: none; }
  .showcase__all:hover { text-decoration: underline; }

  .showcase__card {
    grid-column: span 6;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .showcase__link { text-decoration: none; display: block; }
  .showcase__card img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }

  .showcase__name {
    font-family: var(--font-body);
    font-size: var(--t-small);
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
    padding: var(--s-2) var(--s-2) 0;
  }

  .showcase__meta { font-size: var(--t-micro); padding: 2px var(--s-2) 0; }
  .showcase__price { padding: var(--s-1) var(--s-2) var(--s-2); margin-top: auto; font-weight: 500; }

  @media (min-width: 720px) {
    .showcase__head { grid-column: span 12; }
    .showcase__card { grid-column: span 3; }
  }

  @media (min-width: 1024px) {
    .showcase__head { grid-column: span 12; }
    .showcase__card { grid-column: span 3; }
  }
</style>
