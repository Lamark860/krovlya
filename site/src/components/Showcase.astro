---
/**
 * Витрина на главной. По ТЗ (п. 5): один блок, 8 товаров по 4 в ряд,
 * у каждой карточки — «Купить в 1 клик», в конце переливающаяся кнопка в каталог.
 *
 * Тематические подборки («под тёплый пол», «43 класс») никуда не делись —
 * они переезжают на страницу каталога табами, как и просили. Здесь берём
 * по два товара из каждой подборки: так восьмёрка показывает и ламинат,
 * и кварцвинил, и разброс цен, а не восемь почти одинаковых позиций.
 */
import showcase from "../data/showcase.json";
import SectionIntro from "./SectionIntro.astro";
import { strikePrice } from "../lib/pricing";

interface Props {
  direction: "poly" | "plitka";
  catalog?: string;
}

const { direction, catalog = "/catalog" } = Astro.props;
const blocks = (showcase as Record<string, any[]>)[direction] ?? [];

const items = blocks.flatMap((block) => block.items.slice(0, 2)).slice(0, 8);
const money = (value: number) => value.toLocaleString("ru-RU");
---

<section class="showcase" id="catalog">
  <div class="layout">
    <SectionIntro
      eyebrow="со склада и под заказ"
      title="Покрытия в наличии — с укладкой в подарок"
      lead="Показаны позиции со склада. В каталоге больше двух тысяч покрытий: подберём под задачу и бюджет на замере."
    />

    {items.map((item: any) => (
      <article class="tile card">
        {/* Ни фото, ни название больше не ведут на moiremont18.ru (правка п. 1):
            клик по карточке открывает тот же попап, что кнопка ниже. */}
        <button
          type="button"
          class="card__link"
          data-quick
          data-quick-title="Купить в 1 клик"
          data-quick-lead="Перезвоним как можно скорее и уточним детали заказа."
          data-quick-submit="Заказать сейчас"
          data-quick-source={item.name}
        >
          <img src={item.picture} alt={item.name} loading="lazy" width="450" height="450" />
          {/* Название — не заголовок: внутрь кнопки заголовок класть нельзя,
              её содержимое по спецификации только строчное */}
          <span class="card__name">{item.name}</span>
        </button>

        <p class="card__meta muted">
          {[item.vendor, item.params?.["Класс"] && `${item.params["Класс"]} класс`,
            item.params?.["Толщина, мм"] && `${item.params["Толщина, мм"]} мм`]
            .filter(Boolean).join(" · ")}
        </p>

        {/* Единицу не подставляем: в выгрузке она бывает пустой, и молчаливое
            «м²» превращало цену за упаковку в цену за метр. */}
        <p class="card__price num">
          {money(item.price)} <span class="unit">{item.unit ? `₽/${item.unit}` : "₽"}</span>
          <s class="card__old num">{money(strikePrice(item.name, item.price))}</s>
        </p>

        <button
          type="button"
          class="btn card__buy"
          data-quick
          data-quick-title="Купить в 1 клик"
          data-quick-lead="Перезвоним как можно скорее и уточним детали заказа."
          data-quick-submit="Заказать сейчас"
          data-quick-source={item.name}
        >
          Купить в 1 клик
        </button>
      </article>
    ))}

    <p class="showcase__more">
      <a class="btn btn--shine showcase__all" href={catalog}>Перейти в каталог</a>
    </p>
  </div>
</section>

<style>
  /* Карточка товара (.card*) — в tokens.css: тем же классом рисует карточки
     страница каталога, а она собирает их скриптом. */
  .showcase { padding-block: var(--s-4); }
  .showcase__more { grid-column: span 12; max-width: none; display: flex; justify-content: center; }
  .showcase__all { min-width: 280px; }
</style>
