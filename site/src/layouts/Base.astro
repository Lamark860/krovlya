---
import "../styles/tokens.css";
import { company } from "../data/company";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Сборка идёт в format: "file", поэтому pathname здесь — «/poly.html».
// Отдаётся же адрес без расширения, и canonical обязан указывать ровно на него,
// иначе поисковик видит две версии страницы.
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "");
const canonical = new URL(path, Astro.site);

// Стенд закрыт от поиска: недоделанный лендинг клиента в выдаче — прямой вред.
// Открывается одним флагом при выкатке на боевой домен (см. _local_docs/11_DEPLOY.md).
const indexable = import.meta.env.PUBLIC_INDEXABLE === "1";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#092532" />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />

    <!-- Подстановка города до первой отрисовки: иначе заголовок мигает.
         Роботам и при отсутствии параметра — всегда значение по умолчанию. -->
    <script is:inline define:vars={{ geo: company.geo }}>
      (() => {
        const key = new URLSearchParams(location.search).get("city");
        const city = key && geo.cities[key];
        if (!city) return;
        document.documentElement.dataset.city = key;
        addEventListener("DOMContentLoaded", () => {
          // В заголовок — предложный падеж, в заявку — название города.
          document.querySelectorAll("[data-geo]").forEach((el) => (el.textContent = city.phrase));
          document.querySelectorAll("input[name=geo]").forEach((el) => (el.value = city.label));
        });
      })();
    </script>

    <!-- Яндекс.Метрика, счётчик 111958532. Код прислан заказчиком 26.08 как есть,
         менять его настройки нельзя: по ним же собран доступ в Директе.
         Стоит на всех страницах — иначе не считается путь «главная → посадочная». -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) return;
        }
        k = e.createElement(t); a = e.getElementsByTagName(t)[0];
        k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=111958532", "ym");

      ym(111958532, "init", {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: "dataLayer",
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });
    </script>
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/111958532" style="position:absolute; left:-9999px;" alt="" /></div></noscript>

    <slot />

    <!-- Слот под виджет чата из amoCRM: подключим, когда решим, нужен ли -->
    <!-- CHAT -->

    <script>
      // Клики, показы форм, глубина просмотра, рекламные метки — всё, что
      // не привязано к конкретному компоненту. Цели заявок отправляют
      // сами обработчики форм: только там видно ответ сервера.
      import { startAnalytics } from "../scripts/analytics";
      startAnalytics();
    </script>
  </body>
</html>
