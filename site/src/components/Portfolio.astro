---
/**
 * Портфолио объектов. Структура по ТЗ Артура от 14.08:
 * 8 кейсов, у каждого — главное фото, лента миниатюр, характеристики объекта
 * и кнопка «Хочу так же» (вместо «Смотреть подробнее» у референса).
 * Кнопки «Перейти в портфолио» нет — все кейсы на месте.
 *
 * С 02.09 блок общий на оба направления: кейсы берутся из `portfolio.json`
 * по `direction`, заголовки приходят пропсами. У полов кадры горизонтальные,
 * у санузлов — вертикальные, поэтому пропорция обложки тоже пропс: кадрировать
 * присланное фото санузла под 4:3 значит отрезать у него пол или потолок.
 *
 * Полы: фото по ссылкам от заказчика (17.08 и 26.08), лежат у нас —
 * ссылки вели на сторонние сайты, хотлинк не оставляем. Цифры в `specs`
 * выдуманы и на странице ничем не помечены (вопрос 30).
 * Плитка: 27 фото восьми санузлов, архив от Артура 02.09. `specs` пустые
 * сознательно — кроме названия ЖК о них ничего достоверного не известно.
 *
 * Плашка «черновик» скрыта с 27.08 (`draft: false`): служебная надпись
 * «ждём данные по объектам» на рекламной странице отпугивает покупателя,
 * а не защищает нас. Разметка плашки оставлена — `draft: true` вернёт её
 * одной правкой в данных.
 * Пустой `cover` рисуется заглушкой, лента миниатюр при пустом `shots`
 * не выводится, а пустой `specs` не оставляет от себя дыру в карточке:
 * битых картинок и пустых блоков на странице быть не должно.
 */
import portfolio from "../data/portfolio.json";
import SectionIntro from "./SectionIntro.astro";

interface Props {
  direction: "poly" | "plitka";
  eyebrow: string;
  title: string;
  lead: string;
  /** Пропорция кадра, как в CSS: «4 / 3» у полов, «3 / 4» у санузлов. */
  ratio?: string;
  /** Подпись в попапе «Хочу так же»: у пола считают метр, у санузла — объект. */
  quickLead?: string;
}

const {
  direction,
  eyebrow,
  title,
  lead,
  ratio = "4 / 3",
  quickLead = "Перезвоним, посчитаем ваш метраж и назовём цену за метр вместе с укладкой.",
} = Astro.props;

// В JSON рядом с кейсами лежат `_comment` и `draft`, поэтому не Record<string, Case[]>.
const cases = (portfolio as any)[direction] as {
  id: string; title: string; cover: string; shots: string[]; specs: Record<string, string>;
}[];
const { draft } = portfolio;

// Размеры в атрибутах — под ту же пропорцию: иначе браузер резервирует не ту
// высоту, и страница дёргается, пока грузятся фото.
const [rw, rh] = ratio.split("/").map((n) => Number(n.trim()));
const coverW = 480;
const coverH = Math.round((coverW * rh) / rw);
const shotW = 120;
const shotH = Math.round((shotW * rh) / rw);
---

<section class="folio" id="portfolio" style={`--folio-ratio: ${ratio}`}>
  <div class="layout">
    <SectionIntro eyebrow={eyebrow} title={title} lead={lead}>
      {draft && (
        <p class="folio__draft">
          Черновик блока: фото — присланные ссылки, цифры — примеры структуры. Ждём данные по объектам.
        </p>
      )}
    </SectionIntro>

    {cases.map((item) => (
      <article class="tile folio__case" data-case>
        <div class="folio__cover">
          {item.cover
            ? <img src={item.cover} alt={item.title} loading="lazy" width={coverW} height={coverH} data-cover />
            : <span class="folio__ph" data-cover-ph>фото объекта</span>}
        </div>

        {item.shots.length > 0 && (
          <ul class="folio__shots">
            {item.shots.map((shot: string, i: number) => (
              <li>
                <button type="button" class="folio__shot" data-shot={shot} aria-label={`Фото ${i + 1}`}>
                  <img src={shot} alt="" loading="lazy" width={shotW} height={shotH} />
                </button>
              </li>
            ))}
          </ul>
        )}

        <div class="folio__body">
          <h3 class="folio__title">{item.title}</h3>

          {Object.keys(item.specs).length > 0 && (
            <dl class="folio__specs">
              {Object.entries(item.specs).map(([label, value]) => (
                <div class="folio__row">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          )}

          <button
            type="button"
            class="btn folio__cta"
            data-analytics="cta"
            data-cta-id="case_same"
            data-placement="portfolio"
            data-target="form"
            data-quick
            data-quick-title="Хочу так же"
            data-quick-lead={quickLead}
            data-quick-submit="Жду звонка"
            data-quick-source={`Кейс: ${item.title}`}
          >
            Хочу так же
          </button>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  // Миниатюра меняет главное фото кейса. Делегирование — карточек восемь,
  // и каждая может обзавестись своей лентой.
  document.addEventListener("click", (event) => {
    const shot = (event.target as HTMLElement).closest<HTMLElement>(".folio__shot");
    if (!shot) return;

    const card = shot.closest("[data-case]");
    const cover = card?.querySelector<HTMLImageElement>("[data-cover]");
    if (!cover) return;

    const next = shot.dataset.shot!;
    const previous = cover.src;
    cover.src = next;
    // Меняем местами, чтобы предыдущий кадр не пропадал из ленты
    (shot.querySelector("img") as HTMLImageElement).src = previous;
    shot.dataset.shot = previous;
  });
</script>

<style>
  .folio { padding-block: var(--s-4); }

  .folio__draft {
    margin-top: var(--s-2);
    padding: var(--s-1) var(--s-2);
    background: var(--accent-tint);
    border-left: 3px solid var(--accent);
    font-size: var(--t-small);
  }

  .folio__case {
    grid-column: span 12;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* `min-height: 0` обязателен: карточка — колоночный флекс, и у обложки
     как флекс-элемента автоматический минимум равен высоте содержимого.
     Кадр, снятый в 2:3 вместо 3:4, растягивал свою карточку на 57 px выше
     соседних, и весь ряд ехал за ней. Теперь высоту задаёт только пропорция,
     а лишнее подрезает object-fit. */
  .folio__cover {
    aspect-ratio: var(--folio-ratio, 4 / 3);
    min-height: 0;
    background: var(--bg);
  }
  .folio__cover img { width: 100%; height: 100%; object-fit: cover; }

  /* Заглушка вместо фото: штриховка «под затирку», без единого файла */
  .folio__ph {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      var(--bg) 0 8px,
      var(--surface) 8px 16px
    );
    color: var(--ink-2);
    font-family: var(--font-num);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Лента миниатюр — отдельный ряд, а не продолжение обложки. Двумя правками
     от 02.09 (правка Максима):
      • отступ сверху и выравнивание по тексту карточки: вплотную к фото лента
        читалась как его нижний край, а не как «вот ещё кадры этого объекта»;
      • кадры фиксированной ширины вместо растянутых на всю ширину. Растянутые
        были попыткой закрыть пустоту справа, но у кейса с двумя кадрами
        превращались в две широкие плашки под вертикальным фото. Мелкие кадры
        слева, а свободное место справа — обычная лента, а не дыра в сетке. */
  .folio__shots {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-2);
    padding: 0 var(--s-2);
    list-style: none;
  }

  /* Флекс-элементы здесь — `li`, а не кнопка внутри неё. */
  .folio__shots > li { flex: 0 0 auto; }

  .folio__shot {
    display: block;
    width: 64px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Пропорция та же, что у обложки: миниатюра — уменьшенный тот же кадр,
     и на месте обложки он окажется без сюрприза. */
  .folio__shot img {
    display: block;
    width: 100%;
    aspect-ratio: var(--folio-ratio, 4 / 3);
    object-fit: cover;
    transition: opacity 0.15s ease;
  }

  .folio__shot:hover img,
  .folio__shot:focus-visible img { opacity: 0.7; }

  .folio__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-2) var(--s-2);
    flex: 1;
  }

  .folio__title { font-size: var(--t-h3); }

  .folio__specs { display: grid; gap: 2px; font-size: var(--t-small); }

  .folio__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: var(--s-2);
    padding-block: 3px;
    border-bottom: 1px solid var(--line);
  }

  .folio__row:last-child { border-bottom: 0; }
  .folio__specs dt { color: var(--ink-2); }
  .folio__specs dd { margin: 0; }

  .folio__cta { margin-top: auto; width: 100%; }

  @media (min-width: 720px) {
    .folio__case { grid-column: span 6; }

    /* Два ряда под заголовок: названия объектов разной длины, и без этого
       характеристики соседних кейсов стоят на разной высоте. В один столбец
       выравнивать не с чем — там это была бы просто дыра под заголовком. */
    .folio__title { min-height: calc(var(--t-h3) * 1.2 * 2); }
  }

  @media (min-width: 1024px) {
    .folio__case { grid-column: span 3; }
  }
</style>
