---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Quiz from "../components/Quiz.astro";
import Steps from "../components/Steps.astro";
import Showcase from "../components/Showcase.astro";
import Faq from "../components/Faq.astro";
import LeadForm from "../components/LeadForm.astro";
import ExitPopup from "../components/ExitPopup.astro";
import Footer from "../components/Footer.astro";
import showcase from "../data/showcase.json";

// Образцы первого экрана — реальные позиции со склада, по одной из разных подборок:
// так видно и ламинат, и кварцвинил, и разброс цен.
const blocks = (showcase as any).poly;
const heroSamples = [
  blocks[1]?.items[0],  // ламинат 33 класса
  blocks[2]?.items[0],  // кварцвинил
  blocks[0]?.items[1],  // под тёплый пол
  blocks[3]?.items[0],  // 43 класс
].filter(Boolean);

const steps = [
  { title: "Замер", text: "Приезжаем, считаем площадь с подрезкой и смотрим основание. Ничего не навязываем.", free: true },
  { title: "Подбор", text: "Показываем варианты под нагрузку помещения и бюджет — в шоуруме или онлайн.", free: true },
  { title: "Расчёт", text: "Считаем материал и работы одной сметой. Цену фиксируем на 14 дней." },
  { title: "Хранение и доставка", text: "Купленный материал храним на складе до начала работ — можно взять цену сегодня, а ремонт начать позже.", free: true },
  { title: "Укладка", text: "Своя бригада. Подложка, плинтус, порожки — в той же смете, без «мастер приедет — договоритесь»." },
  { title: "Сдача", text: "Проверяем пол вместе с вами, убираем за собой." },
];

const faq = [
  {
    q: "Чем кварцвинил лучше ламината?",
    a: "Кварцвинил не боится воды: его кладут в санузлы, на кухни и в прихожие, он не разбухает от лужи и мытья. Ламинат теплее на ощупь и дешевле, но воду переносит хуже даже во влагостойких версиях.",
  },
  {
    q: "Что можно класть на тёплый пол?",
    a: "И кварцвинил, и часть коллекций ламината — но у каждого покрытия есть предел температуры, обычно +27 °C. В каталоге совместимость указана в характеристиках, на замере проверим ваш конкретный пирог пола.",
  },
  {
    q: "Какой класс выбрать?",
    a: "Для обычной квартиры хватает 32–33 класса ламината. Под аренду, коммерцию или дом с животными берут 34 класс или кварцвинил 43 класса — там толще защитный слой.",
  },
  {
    q: "Нужно ли выравнивать основание?",
    a: "Почти всегда: замковые покрытия требуют перепада не больше 2 мм на 2 метра. Иначе замки расходятся, и пол начинает скрипеть. На замере проверим уровень и скажем честно, нужна ли стяжка.",
  },
  {
    q: "Сколько ждать материал?",
    a: "Позиции со склада отгружаем сразу, остальное — под заказ. Точные сроки по вашей коллекции скажем при расчёте.",
  },
  {
    q: "Можно купить только материал, без укладки?",
    a: "Да. Расчёт количества с подрезкой сделаем в любом случае — это бесплатно и ни к чему не обязывает.",
  },
];
---

<Base
  title="Ламинат и кварцвинил в Ижевске с укладкой — «Мой ремонт»"
  description="Ламинат и кварцвинил в наличии: 2324 покрытия. Расчёт стоимости пола за 2 минуты, бесплатный замер, укладка напольных покрытий в подарок."
>
  <Header />

  <main>
    <Hero
      eyebrow="ламинат · кварцвинил · SPC"
      title="Пол под ключ"
      titleTail="— укладка в подарок"
      lead="Ответьте на 5 вопросов и за 2 минуты узнайте стоимость пола вместе с работой. Цену и подарок закрепим за вами на 14 дней."
      gift="Укладка напольных покрытий в подарок при заказе от 30 м²"
      facts={[
        { value: "2 324", label: "покрытия в наличии и под заказ" },
        { value: "0 ₽", label: "замер, расчёт и консультация" },
        { value: "14 дней", label: "держим рассчитанную цену" },
        { value: "3 месяца", label: "бесплатно храним материал" },
      ]}
      samples={heroSamples}
    />

    <Quiz />

    <Steps title="Как мы делаем пол" steps={steps} />

    <Showcase direction="poly" />

    <Faq items={faq} />

    <LeadForm
      title="Запишитесь на бесплатный замер"
      lead="Приедем, посчитаем площадь с подрезкой, проверим основание и назовём точную стоимость. Замер ни к чему не обязывает."
      submit="Записаться на замер"
    />
  </main>

  <Footer />

  <ExitPopup
    title="Ламинат или кварцвинил: сравнение по 14 параметрам"
    lead="Разбор, из-за чего пол вздувается и расходится в замках — и как не переплатить за класс, который вам не нужен."
    magnet="floor-comparison"
    bullets={[
      "Что реально выдерживает воду, а что только называется влагостойким",
      "Какой класс нужен для квартиры, аренды и дома с животными",
      "Что можно класть на тёплый пол и при какой температуре",
      "На чём можно сэкономить без последствий, а на чём нельзя",
    ]}
  />
</Base>
