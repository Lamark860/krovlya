---
/**
 * Квиз-калькулятор. Один движок на обе посадочные, вопросы и формулы —
 * в `src/data/quiz.ts` (см. `QUIZ.poly` и `QUIZ.plitka`).
 *
 * Устроен так по трём причинам:
 *  • ручного ввода нет — только кнопки (вручную заполняется только контакт);
 *  • живой счётчик подходящих позиций считается по той же выборке, что уходит в фид;
 *  • вопросов ровно пять — столько же, сколько обещано в объявлении и на первом экране.
 *    Канал связи и подарок — это не вопросы о поле, они живут на экране результата.
 */
import Person from "./Person.astro";
import { QUIZ } from "../data/quiz";

interface Props {
  direction: "poly" | "plitka";
  /** Заголовок секции; часть после <b> красится акцентом */
  title: string;
  accent: string;
  /** Подпись под фото менеджера: чем именно мы считаем честно */
  personNote: string;
}

const { direction, title, accent, personNote } = Astro.props;
const config = QUIZ[direction];
const steps = config.steps.length;
---

<section class="quiz section" id="quiz" data-quiz data-direction={direction}>
  <div class="layout">
    <div class="tile quiz__intro">
      <p class="eyebrow">расчёт за 2 минуты · {steps} вопросов</p>
      <h2>{title} <span class="quiz__accent">{accent}</span></h2>
      <p class="quiz__promise">
        Приблизительную стоимость вы увидите сразу — <b>без отправки контактных данных</b>.
      </p>
    </div>

    <div class="tile quiz__box">
      <div class="quiz__bar" role="progressbar" aria-label="Прогресс расчёта" data-quiz-bar-box>
        <span class="quiz__bar-fill" data-quiz-bar></span>
      </div>

      <header class="quiz__head">
        <p class="quiz__progress num" data-quiz-progress>шаг 1 из {steps}</p>
        <h3 class="quiz__title" data-quiz-title>{config.steps[0].title}</h3>
      </header>

      <div class="quiz__body" data-quiz-body></div>

      <footer class="quiz__foot">
        <button class="btn btn--ghost quiz__back" data-quiz-back hidden>Назад</button>
        <p class="quiz__counter num" data-quiz-counter aria-live="polite"></p>
      </footer>
    </div>

    {/* Живой человек рядом с расчётом: обещание «поможем выбрать» с лицом
        читается как чьё-то, а не как строчка в вёрстке.
        На телефоне блок раньше просто пропадал (правка Артура п. 3) —
        теперь стоит под квизом строкой: фото слева, текст справа. */}
    <aside class="tile quiz__person">
      <Person />
      <p class="quiz__person-text small muted">{personNote}</p>
    </aside>
  </div>
</section>

<script>
  import { QUIZ, rowPrice, rowPerMetre } from "../data/quiz";
  import type { Answers, QuizOption } from "../data/quiz";
  import {
    fillTracking, leadError, leadSuccess, onceThisVisit, trackMetrika, trackingParams,
    validationError, watchForm,
  } from "../scripts/analytics";

  // Направление приезжает из разметки: у скрипта нет пропсов, а держать
  // две сборки одного компонента ради одной строки — хуже.
  const section = document.querySelector<HTMLElement>("[data-quiz]")!;
  const config = QUIZ[section.dataset.direction ?? "poly"];
  const STEPS = config.steps;

  // Каналы связи одинаковы на всех формах сайта, поэтому живут здесь,
  // а не в конфигурации направления.
  const CHANNELS = [
    { value: "telegram", label: "Telegram" },
    { value: "max", label: "MAX" },
    { value: "phone", label: "Звонок" },
  ];

  type Row = (string | number)[];
  let data: { items: Row[]; price: { p25: number; median: number; p75: number } } | null = null;

  // Аналитика квиза. `quiz_start` шлём на первом ответе, а не на показе секции:
  // квиз стоит в середине страницы, и мимо него прокручивают чаще, чем отвечают.
  const QUIZ_ID = `${section.dataset.direction ?? "poly"}_quiz`;
  let quizStarted = false;
  let quizFinished = false;

  const markStart = () => {
    if (quizStarted) return;
    quizStarted = true;
    trackMetrika("quiz_start", { quiz_id: QUIZ_ID, placement: "quiz" });
  };

  /**
   * Ответы квиза для параметров цели: коды вариантов, ничего личного.
   * Имя, телефон и способ связи сюда не попадают — в Метрике им не место,
   * а без разреза «санузел / фартук / фасад» отчёт бесполезен.
   */
  const anonymised = (): Record<string, string> => {
    const out: Record<string, string> = {};
    for (const step of STEPS) {
      const value = answers[step.id];
      if (value == null) continue;
      out[step.id] = Array.isArray(value) ? value.join(",") : String(value);
    }
    // Отдельным привычным именем: по нему Артур строит отчёт в Директе.
    out.area_group = out.size ?? out.rooms ?? "unknown";
    return out;
  };

  const answers: Answers = { ...config.defaults };
  let index = 0;

  const box = document.querySelector<HTMLElement>(".quiz__box")!;
  const body = box.querySelector<HTMLElement>("[data-quiz-body]")!;
  const title = box.querySelector<HTMLElement>("[data-quiz-title]")!;
  const progress = box.querySelector<HTMLElement>("[data-quiz-progress]")!;
  const counter = box.querySelector<HTMLElement>("[data-quiz-counter]")!;
  const back = box.querySelector<HTMLButtonElement>("[data-quiz-back]")!;
  const bar = box.querySelector<HTMLElement>("[data-quiz-bar]")!;
  const barBox = box.querySelector<HTMLElement>("[data-quiz-bar-box]")!;

  /** Прогресс-бар: доля от 0 до 1. Дублируем в aria — полоска без числа
      ничего не говорит скринридеру. */
  function setBar(share: number) {
    const percent = Math.round(share * 100);
    bar.style.width = `${percent}%`;
    barBox.setAttribute("aria-valuenow", String(percent));
    barBox.setAttribute("aria-valuetext", `пройдено ${percent} процентов`);
  }

  async function ensureData() {
    if (data) return data;
    try {
      const response = await fetch(config.dataUrl);
      if (!response.ok) return null;
      data = await response.json();
    } catch {
      return null;   // сеть отвалилась — решает вызывающий, не роняем квиз
    }
    return data;
  }

  /** Сколько позиций каталога подходит под уже данные ответы. */
  function matching(): number {
    if (!data) return 0;
    return data.items.filter((row) => config.matches(row, answers)).length;
  }

  /** Минимум позиций, на которых квартили ещё что-то значат.
      На выборке из трёх товаров «от и до» — это цены трёх товаров, а не рынка. */
  const ENOUGH = 20;

  function estimate() {
    const info = config.area(answers);

    // Цены берём только у позиций с ценой за метр: у 633 плиток единица
    // в выгрузке пустая, и одна цена за упаковку задирает верх вилки.
    const metred = data!.items.filter(rowPerMetre);
    const pool = metred.filter((row) => config.matches(row, answers));
    const prices = (pool.length >= ENOUGH ? pool : metred).map(rowPrice).sort((a, b) => a - b);
    const low = prices[Math.floor(prices.length / 4)];
    const high = prices[Math.floor((prices.length * 3) / 4)];

    const [rawWorkLow, rawWorkHigh] = config.work(info, answers);
    const gift = config.workIsGift(answers);
    const materialLow = Math.round(low * info.material);
    const materialHigh = Math.round(high * info.material);
    const workLow = gift ? 0 : rawWorkLow;
    const workHigh = gift ? 0 : rawWorkHigh;
    // Ноль в работах бывает по двум разным причинам, и путать их нельзя:
    // либо работы дарим по акции, либо человек их просто не заказывал.
    const workNote = gift ? " — по акции в подарок" : workHigh === 0 ? " — вы считаете только материал" : "";

    return {
      area: info.area,
      material: info.material,
      note: info.note,
      materialLow,
      materialHigh,
      workLow,
      workHigh,
      workNote,
      totalLow: materialLow + workLow,
      totalHigh: materialHigh + workHigh,
    };
  }

  const money = (value: number) => value.toLocaleString("ru-RU");

  function optionMarkup(option: { value: string; label: string; note?: string }, active: boolean) {
    return `
      <button type="button" class="control quiz__option${active ? " is-active" : ""}" data-value="${option.value}">
        <span class="quiz__option-label">${option.label}</span>
        ${option.note ? `<span class="quiz__option-note muted">${option.note}</span>` : ""}
      </button>`;
  }

  function renderStep() {
    const step = STEPS[index];
    title.textContent = step.title;
    progress.textContent = `шаг ${index + 1} из ${STEPS.length}`;
    setBar((index + 1) / STEPS.length);
    back.hidden = index === 0;

    const selected = answers[step.id];
    body.innerHTML = `
      ${step.hint ? `<p class="quiz__hint muted small">${step.hint}</p>` : ""}
      <div class="quiz__options">
        ${step.options.map((option) => optionMarkup(option, step.multiple
          ? Array.isArray(selected) && selected.includes(option.value)
          : selected === option.value)).join("")}
      </div>
      ${step.multiple ? `<button class="btn quiz__next" data-next>Показать расчёт</button>` : ""}
    `;

    body.querySelectorAll<HTMLButtonElement>(".quiz__option").forEach((button) => {
      button.addEventListener("click", () => choose(step, button.dataset.value!));
    });
    body.querySelector<HTMLButtonElement>("[data-next]")?.addEventListener("click", advance);
    updateCounter();
  }

  function choose(step: Step, value: string) {
    markStart();
    if (step.multiple) {
      const current = new Set(Array.isArray(answers[step.id]) ? (answers[step.id] as string[]) : []);
      if (value === "none") current.clear();
      else current.delete("none");
      current.has(value) ? current.delete(value) : current.add(value);
      answers[step.id] = [...current];
      renderStep();
      return;
    }
    answers[step.id] = value;
    advance();
  }

  async function advance() {
    // Номер шага уходит строкой, и это не косметика: числовые значения параметров
    // Метрика суммирует и усредняет вместо того, чтобы разложить по строкам отчёта,
    // и воронка по шагам не собирается вовсе. Строки она считает по различным
    // значениям — ровно то, что нужно. Число оставляем отдельным ключом:
    // по нему видно средний шаг, до которого доходят.
    //
    // Один шаг — одно событие за визит, как у `form_view` и `faq_open`: иначе
    // тот, кто вернулся назад и переответил, выглядит в воронке как двое.
    if (onceThisVisit(`quiz_step:${QUIZ_ID}:${index + 1}`)) {
      trackMetrika("quiz_step_complete", {
        quiz_id: QUIZ_ID,
        step: `step_${index + 1}`,
        step_number: index + 1,
        total_steps: STEPS.length,
      });
    }

    if (index < STEPS.length - 1) {
      index += 1;
      renderStep();
      return;
    }

    // Данные каталога тянутся лениво, а расчёт без них падает. Кто пройдёт квиз
    // быстрее, чем приедут 62 КБ (мобильный интернет, холодный кэш), упирался
    // в мёртвую кнопку: ошибка в консоли, на экране ничего.
    const next = body.querySelector<HTMLButtonElement>("[data-next]");
    if (!data && next) {
      next.disabled = true;
      next.textContent = "Считаем…";
    }

    if (!(await ensureData())) {
      // Телефон берём из шапки: у скрипта нет доступа к данным компании,
      // а дублировать номер в разметке — значит однажды забыть его обновить.
      const tel = document.querySelector<HTMLAnchorElement>('a[href^="tel:"]');
      body.innerHTML = `<p>Не получилось загрузить каталог — посчитаем вручную, это быстро.`
        + (tel ? ` Позвоните: <a class="phone" href="${tel.href}"
             data-analytics="phone" data-placement="quiz_fallback">${tel.textContent!.trim()}</a>` : "")
        + `</p>`;
      return;
    }

    renderResult();
  }

  function plural(count: number, forms: [string, string, string]) {
    const n = Math.abs(count) % 100;
    const n1 = n % 10;
    if (n > 10 && n < 20) return forms[2];
    if (n1 > 1 && n1 < 5) return forms[1];
    if (n1 === 1) return forms[0];
    return forms[2];
  }

  function updateCounter() {
    if (!data) {
      counter.textContent = "";
      return;
    }
    const count = matching();
    counter.textContent = count
      ? `подходит ${money(count)} ${plural(count, config.counterForms)} из каталога`
      : "";
  }

  function renderResult() {
    const result = estimate();

    // Расчёт человек увидел — для аналитики квиз пройден, даже если контакт
    // он не оставит. Это и есть разница между `quiz_complete` и `quiz_lead_success`.
    if (!quizFinished) {
      quizFinished = true;
      trackMetrika("quiz_complete", { quiz_id: QUIZ_ID, steps_completed: STEPS.length });
    }

    title.textContent = "Ваш предварительный расчёт";
    progress.textContent = `${money(result.area)} м² · подходит ${money(matching())} `
      + plural(matching(), ["позиция", "позиции", "позиций"]);
    setBar(1);
    back.hidden = true;
    counter.textContent = "";

    body.innerHTML = `
      <div class="quiz__result">
        <div class="quiz__sum">
          <p class="quiz__range num">${money(result.totalLow)} — ${money(result.totalHigh)} <span class="unit">₽</span></p>
          <p class="quiz__metres small">${result.note}</p>
          <ul class="quiz__breakdown">
            <li><span>${config.materialLabel}</span>
                <b class="num">${money(result.materialLow)}—${money(result.materialHigh)} <span class="unit">₽</span></b></li>
            <li><span>Работы${result.workNote}</span>
                <b class="num">${result.workLow === 0 ? "0" : `${money(result.workLow)}—${money(result.workHigh)}`} <span class="unit">₽</span></b></li>
          </ul>
          <p class="micro muted">Предварительный расчёт. Точная смета — после бесплатного замера.</p>
        </div>

        <form class="quiz__form" data-lead-form
              data-analytics-form="lead" data-form-id="quiz_form"
              data-placement="quiz" data-lead-type="calculation">
          <fieldset class="quiz__fieldset">
            <legend class="eyebrow">выберите подарок</legend>
            <div class="quiz__options quiz__options--compact" data-gift>
              ${config.gifts.map((gift) => optionMarkup(gift, answers.gift === gift.value)).join("")}
            </div>
          </fieldset>

          <fieldset class="quiz__fieldset">
            <legend class="eyebrow">куда отправить расчёт</legend>
            <div class="channel" data-channel-group>
              ${CHANNELS.map((channel) => `
                <button type="button" class="channel__btn${answers.channel === channel.value ? " is-active" : ""}"
                        data-channel="${channel.value}">${channel.label}</button>`).join("")}
            </div>
          </fieldset>

          <label class="field">
            <span class="field__label">Как к вам обращаться</span>
            <input name="name" required autocomplete="name" placeholder="Имя" />
          </label>
          <label class="field">
            <span class="field__label" data-contact-label>Введите телефон или @username в Telegram</span>
            <input name="contact" required inputmode="tel" data-contact placeholder="+7 " />
          </label>

          <input type="text" name="company" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <input type="hidden" name="utm_source" data-utm-field="utm_source" />
          <input type="hidden" name="utm_medium" data-utm-field="utm_medium" />
          <input type="hidden" name="utm_campaign" data-utm-field="utm_campaign" />
          <input type="hidden" name="utm_content" data-utm-field="utm_content" />
          <input type="hidden" name="utm_term" data-utm-field="utm_term" />
          <input type="hidden" name="yclid" data-utm-field="yclid" />

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>Согласен на <a href="/privacy">обработку персональных данных</a> и <a href="/cookies">использование cookie</a></span>
          </label>

          <button class="btn" type="submit">Забронировать подарок и получить консультацию</button>
          <p class="quiz__note micro muted">За вашим контактом закрепим эту цену и подарок на 14 дней.</p>
          <p class="quiz__error small" data-error hidden></p>
        </form>
      </div>
    `;

    const form = body.querySelector<HTMLFormElement>("[data-lead-form]")!;
    const contact = form.querySelector<HTMLInputElement>("[data-contact]")!;
    const label = form.querySelector<HTMLElement>("[data-contact-label]")!;

    // Форма появилась только сейчас, поэтому подписку и рекламные метки
    // общий скрипт страницы уже не проставит — делаем это сами.
    watchForm(form);
    fillTracking(form);

    // Подпись и подсказка меняются вместе: иначе выбран Telegram,
    // а поле подсказывает «+7 » — и человек не понимает, что можно дать @username.
    const setChannelLabel = () => {
      const [подпись, подсказка] = answers.channel === "telegram"
        ? ["Введите телефон или @username в Telegram", "+7 или @username"]
        : answers.channel === "max"
          ? ["Введите номер телефона в MAX", "+7 "]
          : ["Введите ваш телефон", "+7 "];
      label.textContent = подпись;
      contact.placeholder = подсказка;
    };

    form.querySelectorAll<HTMLButtonElement>(".quiz__option").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        answers.gift = button.dataset.value!;
        form.querySelectorAll(".quiz__option").forEach((b) => b.classList.remove("is-active"));
        button.classList.add("is-active");
        renderResultTotals();
      });
    });

    form.querySelectorAll<HTMLButtonElement>("[data-channel]").forEach((button) => {
      button.addEventListener("click", () => {
        answers.channel = button.dataset.channel!;
        form.querySelectorAll("[data-channel]").forEach((b) => b.classList.remove("is-active"));
        button.classList.add("is-active");
        setChannelLabel();
      });
    });

    // И сразу при отрисовке: в разметке подсказка задана телефонной,
    // а канал по умолчанию — Telegram. Иначе они расходятся до первого клика.
    setChannelLabel();

    function renderResultTotals() {
      const updated = estimate();
      const range = body.querySelector<HTMLElement>(".quiz__range")!;
      range.innerHTML = `${money(updated.totalLow)} — ${money(updated.totalHigh)} <span class="unit">₽</span>`;
      const work = body.querySelectorAll(".quiz__breakdown li")[1];
      if (work) {
        work.innerHTML = `<span>Работы${updated.workNote}</span>
          <b class="num">${updated.workLow === 0 ? "0" : `${money(updated.workLow)}—${money(updated.workHigh)}`} <span class="unit">₽</span></b>`;
      }
    }

    // Мягкая маска: форматируем по мере ввода, ничего не блокируем и шаблон не подставляем.
    contact.addEventListener("input", () => {
      if (contact.value.startsWith("@")) return;
      const digits = contact.value.replace(/\D/g, "").replace(/^8/, "7").slice(0, 11);
      if (!digits) return;
      const rest = digits.slice(1);
      contact.value = "+7"
        + (rest.length ? ` (${rest.slice(0, 3)}` : "")
        + (rest.length > 3 ? `) ${rest.slice(3, 6)}` : "")
        + (rest.length > 6 ? `-${rest.slice(6, 8)}` : "")
        + (rest.length > 8 ? `-${rest.slice(8, 10)}` : "");
    });

    const startedAt = Date.now();
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
      const error = form.querySelector<HTMLElement>("[data-error]")!;

      // Та же проверка, что и в общем обработчике форм: браузер видит
      // недописанный номер как обычный текст и молча отправляет его на сервер.
      const value = contact.value.trim();
      const digits = value.replace(/\D/g, "");
      const okUsername = answers.channel === "telegram" && /^@[\w\d_]{4,32}$/.test(value);
      if (!okUsername && (digits.length < 10 || digits.length > 11)) {
        validationError(form, "contact", value ? "invalid_phone" : "empty_required_field");
        error.textContent = value ? "Проверьте номер телефона" : "Оставьте номер телефона";
        error.hidden = false;
        contact.focus();
        return;
      }

      button.disabled = true;
      error.hidden = true;

      const payload = {
        name: (form.elements.namedItem("name") as HTMLInputElement).value,
        contact: contact.value,
        channel: answers.channel,
        company: (form.elements.namedItem("company") as HTMLInputElement).value,
        consent: (form.elements.namedItem("consent") as HTMLInputElement).checked,
        elapsed: Date.now() - startedAt,
        page: location.pathname,
        geo: document.querySelector<HTMLInputElement>("input[name=geo]")?.value ?? "",
        quiz: { ...answers, estimate: estimate() },
        utm: { ...Object.fromEntries(new URLSearchParams(location.search)), ...trackingParams() },
      };

      try {
        const response = await fetch("/api/lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await response.json();
        if (!response.ok) throw new Error(json.error ?? "Не удалось отправить");
        sessionStorage.setItem("lead", JSON.stringify({ name: payload.name, channel: answers.channel }));
        // В параметры цели уходят только обезличенные ответы: что отделываем,
        // какая площадь, что нужно. Имени и телефона в Метрике быть не должно.
        await leadSuccess(form, {
          quiz_id: QUIZ_ID,
          steps_completed: STEPS.length,
          channel: answers.channel,
          ...anonymised(),
        });
        location.href = "/thanks";
      } catch (problem) {
        leadError(form, problem instanceof TypeError ? "network_error" : "server_error");
        error.textContent = problem instanceof Error ? problem.message : "Не удалось отправить";
        error.hidden = false;
        button.disabled = false;
      }
    });
  }

  back.addEventListener("click", () => {
    if (index > 0) {
      index -= 1;
      renderStep();
    }
  });

  // Данные счётчика тянем при появлении квиза в поле зрения: на первый экран не влияет
  const observer = new IntersectionObserver(async (entries) => {
    if (!entries.some((entry) => entry.isIntersecting)) return;
    observer.disconnect();
    await ensureData();
    updateCounter();
  }, { rootMargin: "300px" });
  observer.observe(box);

  renderStep();
</script>

