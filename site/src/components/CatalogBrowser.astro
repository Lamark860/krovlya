---
/**
 * Каталог: фильтры, сетка карточек и подгрузка по 24. Один компонент на оба
 * направления — страницы `/catalog` и `/catalog-plitka` отличаются заголовками
 * и файлом данных, а поведение обязано совпадать до мелочей.
 *
 * Карточки рисует скрипт из /data/catalog-<направление>.json: позиций больше
 * двух тысяч, и в статике это мегабайты разметки ради двадцати видимых.
 * Данные готовит pipeline/build_catalog_page.py.
 *
 * Отдельных страниц товара пока нет — карточка открывает попап «в 1 клик».
 * Это открытый вопрос 28: от него зависит, куда указывают ссылки в YML-фиде.
 *
 * Фильтры читаются из адреса: ?group=keramogranit&sub=600x600&brand=vitra.
 * Это нужно рекламе — объявление «керамогранит 600×600» обязано приводить
 * сразу на нужную выборку, а не на общий список. Слаги приходят из того же
 * JSON, что и сам список фильтров.
 */
import SectionIntro from "./SectionIntro.astro";
import { company } from "../data/company";

interface Props {
  /** Файл данных: /data/catalog-poly.json или /data/catalog-plitka.json */
  src: string;
  eyebrow: string;
  title: string;
  accent: string;
  lead: string;
  /** Подпись ряда подгрупп: у полов это класс, у плитки — формат */
  subLabel: string;
  /** Куда ведёт «Рассчитать» — квиз своей посадочной */
  quiz: string;
  quizTitle: string;
  quizLead: string;
}

const { src, eyebrow, title, accent, lead, subLabel, quiz, quizTitle, quizLead } = Astro.props;
---

<section class="offer on-dark">
  <div class="layout">
    <div class="offer__box">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title} <span class="offer__accent">{accent}</span></h1>
      <p class="lead">{lead}</p>
      <p class="offer__actions">
        <a class="btn" href={quiz}>Рассчитать стоимость — 2 минуты</a>
        <a class="btn btn--ghost" href={`tel:${company.phoneHref}`}>{company.phone}</a>
      </p>
    </div>
  </div>
</section>

<section class="cat" data-catalog data-src={src}>
  <div class="layout">
    <div class="tile cat__filters">
      <div class="cat__row">
        <p class="cat__label eyebrow">вид покрытия</p>
        <div class="cat__tabs" role="group" aria-label="Вид покрытия" data-tabs="group">
          <button type="button" class="control cat__tab is-active" data-value="">Все</button>
        </div>
      </div>

      <div class="cat__row" data-row="sub" hidden>
        <p class="cat__label eyebrow">{subLabel}</p>
        <div class="cat__tabs" role="group" aria-label={subLabel} data-tabs="sub"></div>
      </div>

      <div class="cat__row">
        <p class="cat__label eyebrow">бренд</p>
        <div class="cat__tabs" role="group" aria-label="Бренд" data-tabs="brand">
          <button type="button" class="control cat__tab is-active" data-value="">Все</button>
        </div>
      </div>

      <p class="cat__count num muted" data-count aria-live="polite">Загружаем каталог…</p>
    </div>

    <div class="cat__grid" data-grid></div>

    <p class="cat__more">
      <button type="button" class="btn btn--ghost" data-more hidden>Показать ещё</button>
    </p>
  </div>
</section>

<section class="section">
  <div class="layout">
    <SectionIntro eyebrow="бесплатно и быстро" title={quizTitle} lead={quizLead}>
      <a class="btn btn--shine" href={quiz}>Рассчитать стоимость</a>
    </SectionIntro>
  </div>
</section>

<script>
  import { strikePrice } from "../lib/pricing";

  type Item = { n: string; u: string; p: number; e: string; v: string; g: string; s: string; i: string };
  type Named = { n: string; k: string };
  type Group = Named & { subs: Named[] };
  const PAGE = 24;

  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const more = document.querySelector<HTMLButtonElement>("[data-more]")!;
  const rows = {
    group: document.querySelector<HTMLElement>('[data-tabs="group"]')!,
    sub: document.querySelector<HTMLElement>('[data-tabs="sub"]')!,
    brand: document.querySelector<HTMLElement>('[data-tabs="brand"]')!,
  };
  const subRow = document.querySelector<HTMLElement>('[data-row="sub"]')!;

  let items: Item[] = [];
  let groups: Group[] = [];
  let brands: Named[] = [];
  let shown = 0;
  const filters = { group: "", sub: "", brand: "" };

  const money = (value: number) => value.toLocaleString("ru-RU");
  const plural = (n: number, forms: [string, string, string]) => {
    const mod10 = n % 10, mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return forms[0];
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return forms[1];
    return forms[2];
  };

  function visible() {
    return items.filter((item) =>
      (!filters.group || item.g === filters.group) &&
      (!filters.sub || item.s === filters.sub) &&
      (!filters.brand || item.v === filters.brand));
  }

  function card(item: Item) {
    const meta = [item.v, item.s].filter(Boolean).join(" · ");
    const unit = item.e ? `₽/${item.e}` : "₽";
    const safeName = item.n.replace(/"/g, "&quot;");
    // Ни фото, ни название не ведут на moiremont18.ru (правка п. 1):
    // клик по карточке открывает тот же попап, что кнопка ниже.
    return `
      <article class="tile card">
        <button type="button" class="card__link"
                data-quick
                data-quick-title="Купить в 1 клик"
                data-quick-lead="Перезвоним как можно скорее и уточним детали заказа."
                data-quick-submit="Заказать сейчас"
                data-quick-source="${safeName}">
          <img src="${item.i}" alt="${safeName}" loading="lazy" width="450" height="450" />
          <span class="card__name">${item.n}</span>
        </button>
        <p class="card__meta">${meta}</p>
        <p class="card__price num">${money(item.p)} <span class="unit">${unit}</span>
          <s class="card__old num">${money(strikePrice(item.n, item.p))}</s></p>
        <button type="button" class="btn card__buy"
                data-quick
                data-quick-title="Купить в 1 клик"
                data-quick-lead="Перезвоним как можно скорее и уточним детали заказа."
                data-quick-submit="Заказать сейчас"
                data-quick-source="${item.n.replace(/"/g, "&quot;")}">Купить в 1 клик</button>
      </article>`;
  }

  function render(reset = false) {
    const list = visible();
    if (reset) { grid.innerHTML = ""; shown = 0; }

    const next = list.slice(shown, shown + PAGE);
    grid.insertAdjacentHTML("beforeend", next.map(card).join(""));
    shown += next.length;

    count.textContent = `${money(list.length)} ${plural(list.length, ["позиция", "позиции", "позиций"])} · показано ${shown}`;
    more.hidden = shown >= list.length;
  }

  function fill(holder: HTMLElement, values: Named[], active: string) {
    const options = [{ n: "Все", v: "" }, ...values.map((value) => ({ n: value.n, v: value.n }))];
    holder.innerHTML = options.map((option) =>
      `<button type="button" class="control cat__tab${option.v === active ? " is-active" : ""}" data-value="${option.v}">${option.n}</button>`).join("");
  }

  // Классы показываем только внутри выбранного вида покрытия. Общим списком
  // «33 класс» ламината и «43 класс» кварцвинила читаются как одна шкала — а это
  // разные шкалы, и «Другие серии» есть у обоих.
  function syncSubs() {
    const subs = groups.find((group) => group.n === filters.group)?.subs ?? [];
    if (!subs.some((sub) => sub.n === filters.sub)) filters.sub = "";
    subRow.hidden = subs.length === 0;
    if (subs.length) fill(rows.sub, subs, filters.sub);
  }

  function fromUrl() {
    // Регистр и пробелы не считаем значащими: слаг в объявление переносят руками,
    // а «Tarkett» вместо «tarkett» не повод показать человеку весь каталог.
    const query = new URLSearchParams(location.search);
    const want = (key: string) => (query.get(key) ?? "").trim().toLowerCase();
    const wantGroup = want("group");
    const wantSub = want("sub");
    const wantBrand = want("brand");

    let group = groups.find((item) => item.k === wantGroup);
    // ?sub=33-klass без группы — достраиваем группу сами: объявление не обязано
    // знать нашу иерархию. Незнакомый слаг молча игнорируем и показываем весь
    // каталог: пустая выдача на оплаченном переходе хуже неточной.
    if (!group && wantSub) group = groups.find((item) => item.subs.some((sub) => sub.k === wantSub));
    if (group) {
      filters.group = group.n;
      filters.sub = group.subs.find((sub) => sub.k === wantSub)?.n ?? "";
    }
    filters.brand = brands.find((brand) => brand.k === wantBrand)?.n ?? "";
  }

  function updateUrl() {
    // Чужие параметры не трогаем: в адресе живут utm-метки, по которым считается
    // реклама, и ?city из шапки. Снести их значило бы потерять атрибуцию заявки.
    const query = new URLSearchParams(location.search);
    for (const key of ["group", "sub", "brand"]) query.delete(key);

    const group = groups.find((item) => item.n === filters.group);
    if (group) query.set("group", group.k);
    const sub = group?.subs.find((item) => item.n === filters.sub);
    if (sub) query.set("sub", sub.k);
    const brand = brands.find((item) => item.n === filters.brand);
    if (brand) query.set("brand", brand.k);

    const qs = query.toString();
    history.replaceState(null, "", qs ? `${location.pathname}?${qs}` : location.pathname);
  }

  function wire(name: "group" | "sub" | "brand") {
    rows[name].addEventListener("click", (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>(".cat__tab");
      if (!tab) return;
      filters[name] = tab.dataset.value ?? "";
      rows[name].querySelectorAll(".cat__tab").forEach((b) => b.classList.toggle("is-active", b === tab));
      if (name === "group") syncSubs();
      render(true);
      updateUrl();
      // Возвращаем к началу списка: иначе после фильтра человек стоит
      // в середине уже другой выдачи и думает, что ничего не изменилось.
      document.querySelector(".cat")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  more.addEventListener("click", () => render());

  // Какой каталог грузить, страница говорит атрибутом: компонент один,
  // направлений два, и вторая копия скрипта разъехалась бы с первой.
  fetch(document.querySelector<HTMLElement>("[data-catalog]")!.dataset.src!)
    .then((response) => {
      if (!response.ok) throw new Error(String(response.status));
      return response.json();
    })
    .then((data: { items: Item[]; groups: Group[]; brands: Named[] }) => {
      items = data.items;
      groups = data.groups;
      brands = data.brands;

      fromUrl();
      fill(rows.group, groups, filters.group);
      fill(rows.brand, brands, filters.brand);
      syncSubs();
      (["group", "sub", "brand"] as const).forEach(wire);
      render(true);
      // Приводим адрес к каноническому виду: опечатка в слаге не применилась —
      // пусть её и в строке не останется, иначе она уедет в отчёты Метрики.
      updateUrl();
    })
    .catch(() => {
      // Пустая страница вместо каталога — потерянный оплаченный переход.
      // Телефон берём из шапки, чтобы не держать вторую копию номера.
      const phone = document.querySelector<HTMLAnchorElement>('a[href^="tel:"]');
      count.textContent = "";
      grid.innerHTML = `<p class="tile cat__fail">Каталог не загрузился — обновите страницу.
        Или позвоните, подберём покрытие и назовём цену:
        ${phone ? `<a class="phone" href="${phone.href}">${phone.textContent!.trim()}</a>` : ""}</p>`;
    });
</script>

<style>
  .offer { padding-block: var(--s-8); }
  .offer__box { grid-column: span 12; display: grid; gap: var(--s-2); justify-items: start; }
  .offer__accent { color: var(--accent); }
  .offer__actions { display: flex; flex-wrap: wrap; gap: var(--seam); margin-top: var(--s-2); max-width: none; }

  .cat { padding-block: var(--s-4); }

  .cat__filters {
    grid-column: span 12;
    display: grid;
    gap: var(--s-2);
  }

  .cat__row { display: grid; gap: var(--s-1); }
  /* display: grid перебивает атрибут hidden — без этого пустой ряд классов остаётся видимым */
  .cat__row[hidden] { display: none; }
  .cat__label { margin: 0; }
  .cat__tabs { display: flex; flex-wrap: wrap; gap: var(--seam); }

  .cat__tab {
    min-height: 40px;
    padding: 0 var(--s-2);
    cursor: pointer;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .cat__count { font-size: var(--t-small); }

  /* Те же 12 колонок, что у .layout, — тогда карточка кладётся по общему
     правилу из tokens.css (2 в ряд на телефоне, 4 на десктопе) и не требует
     собственной раскладки. */
  .cat__grid {
    grid-column: span 12;
    display: grid;
    gap: var(--seam);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .cat__more { grid-column: span 12; max-width: none; display: flex; justify-content: center; }
  .cat__fail { grid-column: span 12; padding: var(--s-4); }
</style>
