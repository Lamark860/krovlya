---
// Хаб: главная разводит два рекламных направления по посадочным.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Мой ремонт — отделочные материалы в Ижевске"
  description="Плитка, керамогранит, ламинат и кварцвинил с укладкой под ключ. Бесплатный замер и расчёт."
>
  <Header />

  <main class="hub">
    <div class="layout">
      <div class="tile hub__box">
        <p class="eyebrow">посадочные страницы</p>
        <h1>Мой ремонт</h1>
        <p class="muted">Отделочные материалы с укладкой под ключ в Ижевске и Завьяловском районе.</p>
        <p class="hub__links">
          <a class="btn" href="/poly"
            data-analytics="cta" data-cta-id="index_poly"
            data-placement="hero" data-target="landing">Ламинат и кварцвинил</a>
          <a class="btn btn--ghost" href="/plitka"
            data-analytics="cta" data-cta-id="index_plitka"
            data-placement="hero" data-target="landing">Плитка и керамогранит</a>
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .hub { padding-block: var(--s-8); }
  .hub__box { grid-column: span 12; padding: var(--s-8) var(--s-4); display: grid; gap: var(--s-2); }
  .hub__links { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
</style>
