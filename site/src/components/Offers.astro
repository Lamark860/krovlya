---
/**
 * Плашки акций. По ТЗ (п. 9) — как блок акций у референса.
 * Наборы — в `src/data/offers.ts`, свой на каждую посадочную.
 */
import SectionIntro from "./SectionIntro.astro";
import { OFFERS } from "../data/offers";

interface Props {
  direction: "poly" | "plitka";
  title: string;
  lead: string;
}

const { direction, title, lead } = Astro.props;
const offers = OFFERS[direction];
---

<section class="offers section">
  <div class="layout">
    <SectionIntro eyebrow="что действует сейчас" title={title} lead={lead} />

    {offers.map((offer) => (
      <article class="tile offer">
        <img class="offer__bg" src={offer.image} alt="" loading="lazy" width="600" height="400" />
        <div class="offer__body">
          <h3 class="offer__title">{offer.title}</h3>
          <p class="offer__text">{offer.text}</p>
          <a class="offer__link" href={offer.href}>{offer.action} →</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .offer {
    grid-column: span 12;
    padding: 0;
    position: relative;
    min-height: 260px;
    display: flex;
    overflow: hidden;
    color: var(--dark-ink);
  }

  .offer__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Фактура покрытия — светлая, текст по ней не читается без затемнения.
     Градиент снизу: верх плашки остаётся фотографией. */
  .offer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(9 37 50 / 0.35) 0%, rgb(9 37 50 / 0.88) 62%);
    z-index: 1;
  }

  .offer__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    margin-top: auto;
    padding: var(--s-4);
  }

  .offer__title { font-size: var(--t-h3); }
  .offer__text { font-size: var(--t-small); color: var(--dark-ink-2); }

  .offer__link {
    margin-top: var(--s-1);
    color: var(--accent);
    font-size: var(--t-small);
    font-weight: 500;
    text-decoration: none;
  }

  .offer__link:hover { text-decoration: underline; }
  .offer__link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (min-width: 720px) {
    .offer { grid-column: span 4; min-height: 320px; }
  }
</style>
