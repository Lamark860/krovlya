---
/**
 * Каталог плитки и керамогранита. Пара к `/catalog`: тот же компонент,
 * свои тексты и свой файл данных.
 *
 * Отдельная страница, а не параметр к `/catalog`, ровно по одной причине —
 * реклама. У объявления «керамогранит 600×600» должен быть свой заголовок
 * и свой <title>, иначе человек по объявлению про плитку видит «Выберите
 * напольное покрытие» (это вопрос 54, вариант «б»).
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import QuickForm from "../components/QuickForm.astro";
import CatalogBrowser from "../components/CatalogBrowser.astro";
---

<Base
  title="Каталог плитки и керамогранита в Ижевске — «Мой ремонт»"
  description="2 650 позиций плитки и керамогранита в наличии и под заказ: крупноформат, 600×600, мелкий формат и «кабанчик». Расчёт количества с подрезкой — бесплатно."
>
  <Header cta="/plitka#lead" catalog="/catalog-plitka" />

  <main>
    <CatalogBrowser
      src="/data/catalog-plitka.json"
      eyebrow="керамогранит · плитка · крупноформат"
      title="Выберите плитку и керамогранит"
      accent="и получите дизайн-проект санузла в подарок"
      lead="Посчитаем количество с подрезкой бесплатно и покажем раскладку до покупки. Замер и консультация — 0 ₽."
      subLabel="формат"
      quiz="/plitka#quiz"
      quizTitle="Не хотите листать каталог?"
      quizLead="Ответьте на пять вопросов — посчитаем, сколько плитки нужно на пол и стены, и назовём вилку стоимости. Контакты для расчёта не нужны."
    />
  </main>

  <Footer />
  <QuickForm />
</Base>
