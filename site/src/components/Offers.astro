---
/**
 * Плашки акций. По ТЗ (п. 9) — как блок акций у референса, но про полы.
 *
 * Картинки не генерим и не покупаем: фон плашки — фактура покрытия из нашего же
 * каталога, поверх типографика. Если Артуру не подойдёт, он пришлёт свои
 * (вопрос 37; нужный размер — 1200×800).
 *
 * Условия акций пока со слов брифа. Точные цифры (от какого метража, до какой
 * даты, что входит) — открытые вопросы 9–11 в 02_QUESTIONS.md; до ответов
 * ни одна плашка не обещает того, чего нет в брифе.
 */
import SectionIntro from "./SectionIntro.astro";

const offers = [
  {
    title: "Укладка напольных покрытий в подарок",
    text: "При заказе материала от 30 м² укладку делает наша бригада, а платите вы только за покрытие.",
    image: "/showcase/54752_8_33_4V.webp",
    action: "Рассчитать с подарком",
    href: "#quiz",
  },
  {
    title: "Дизайн-проект санузла в подарок",
    text: "Раскладка плитки и керамогранита с визуализацией — за 7 дней, при заказе материала у нас.",
    image: "/showcase/3003.webp",
    action: "Получить консультацию",
    href: "#lead",
  },
  {
    title: "Бесплатное хранение до ремонта",
    text: "Купите материал по сегодняшней цене, а заберите когда будете готовы — держим на складе 3 месяца.",
    image: "/showcase/ALX1562-8.webp",
    action: "Узнать условия",
    href: "#lead",
  },
];
---

<section class="offers section">
  <div class="layout">
    <SectionIntro
      eyebrow="что действует сейчас"
      title="Три способа сделать пол выгоднее"
      lead="Подарки суммируются с ценой каталога: это не «скидка вместо скидки», а работы и услуги, за которые обычно платят отдельно."
    />

    {offers.map((offer) => (
      <article class="tile offer">
        <img class="offer__bg" src={offer.image} alt="" loading="lazy" width="600" height="400" />
        <div class="offer__body">
          <h3 class="offer__title">{offer.title}</h3>
          <p class="offer__text">{offer.text}</p>
          <a class="offer__link" href={offer.href}>{offer.action} →</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .offer {
    grid-column: span 12;
    padding: 0;
    position: relative;
    min-height: 260px;
    display: flex;
    overflow: hidden;
    color: var(--dark-ink);
  }

  .offer__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Фактура покрытия — светлая, текст по ней не читается без затемнения.
     Градиент снизу: верх плашки остаётся фотографией. */
  .offer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(9 37 50 / 0.35) 0%, rgb(9 37 50 / 0.88) 62%);
    z-index: 1;
  }

  .offer__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    margin-top: auto;
    padding: var(--s-4);
  }

  .offer__title { font-size: var(--t-h3); }
  .offer__text { font-size: var(--t-small); color: var(--dark-ink-2); }

  .offer__link {
    margin-top: var(--s-1);
    color: var(--accent);
    font-size: var(--t-small);
    font-weight: 500;
    text-decoration: none;
  }

  .offer__link:hover { text-decoration: underline; }
  .offer__link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (min-width: 720px) {
    .offer { grid-column: span 4; min-height: 320px; }
  }
</style>
