---
/**
 * ЛП-1 — плитка и керамогранит. Вторая посадочная, пара к `/poly`.
 *
 * Структура секций та же, что на «Полах» (карта из 12_TZ_PRAVKI.md, п. 2):
 * она уже прокликана заказчиком и отработала два круга правок, изобретать
 * вторую композицию здесь нечего. Отличаются оффер, квиз и акции.
 *
 * Блока портфолио тут нет намеренно: все восемь кейсов — по полам, а кейсов
 * по санузлам заказчик не давал. Выдуманные объекты в портфолио — прямой путь
 * к разговору «а покажите этот адрес».
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Quiz from "../components/Quiz.astro";
import Steps from "../components/Steps.astro";
import Showcase from "../components/Showcase.astro";
import PriceList from "../components/PriceList.astro";
import Magnet from "../components/Magnet.astro";
import Payment from "../components/Payment.astro";
import Offers from "../components/Offers.astro";
import About from "../components/About.astro";
import Consult from "../components/Consult.astro";
import Contacts from "../components/Contacts.astro";
import Faq from "../components/Faq.astro";
import ExitPopup from "../components/ExitPopup.astro";
import QuickForm from "../components/QuickForm.astro";
import Footer from "../components/Footer.astro";

const MAGNET_BULLETS = [
  "Почему плитки нужно на 7–10 % больше, чем площадь стен и пола",
  "На чём экономят при гидроизоляции — и во сколько это обходится потом",
  "Какой формат зрительно расширяет маленький санузел, а какой съедает",
  "Когда ректифицированная плитка оправдана, а когда это переплата",
];

// Основной лид-магнит уходит в exit-попап, второй остаётся блоком на странице —
// правка по методике курса (09_COURSE_NOTES.md, п. 12.5).
const EXIT_BULLETS = [
  "Материал, работы и расходники — отдельными строками",
  "Сколько стоит гидроизоляция и почему её нельзя пропускать",
  "Во что обходится крупноформат против 600×600 на той же площади",
  "Что попадает в смету сверх плитки: клей, затирка, подрезка, вывоз",
];

const steps = [
  { title: "Замер", text: "Приезжаем, считаем площадь стен и пола с подрезкой, смотрим основание и вентиляцию. Ничего не навязываем.", free: true },
  { title: "Раскладка", text: "Дизайнер собирает варианты раскладки под ваш формат и бюджет — с визуализацией, а не «на словах».", free: true },
  { title: "Расчёт", text: "Считаем материал и работы одной сметой. Цену фиксируем на 14 дней." },
  { title: "Хранение и доставка", text: "Купленный материал храним на складе до начала работ — можно взять цену сегодня, а ремонт начать позже.", free: true },
  { title: "Укладка", text: "Своя бригада. Гидроизоляция, клей, затирка и подрезка — в той же смете, без «мастер приедет — договоритесь»." },
  { title: "Сдача", text: "Проверяем санузел вместе с вами, вывозим мусор и убираем за собой." },
];

const faq = [
  {
    q: "Сколько плитки нужно на санузел 4 м²?",
    a: "Считать надо не пол, а всю облицовку: у типового санузла 4 м² стены дают ещё около 18 м². Плюс запас на подрезку — 7 % при простой раскладке и до 10 % при диагонали или ёлочке. Итого выходит около 24 м². Посчитаем вашу площадь бесплатно, даже если купите материал не у нас.",
  },
  {
    q: "Чем керамогранит отличается от керамической плитки?",
    a: "Керамогранит плотнее и почти не впитывает воду, поэтому его кладут на пол, на улицу и в мокрые зоны. Керамическая плитка легче и тоньше — её обычно берут на стены. В санузле чаще всего сочетают: керамогранит на пол, плитку на стены.",
  },
  {
    q: "Что такое ректификат и зачем он нужен?",
    a: "У ректифицированной плитки края обрезаны в размер, поэтому её кладут со швом 1,5–2 мм вместо обычных 3–5 мм. Поверхность выглядит цельной, но требует ровного основания и аккуратной укладки — на кривой стене экономии не выйдет.",
  },
  {
    q: "Можно ли класть плитку на тёплый пол?",
    a: "Да, керамогранит и плитка — лучшее покрытие для тёплого пола: они хорошо проводят тепло и не боятся нагрева. Важнее правильный клей и гидроизоляция, это проверим на замере.",
  },
  {
    q: "Почему крупноформат дороже в укладке?",
    a: "Лист 600×1200 и больше требует идеально ровного основания, двух человек на подъём и специального инструмента для резки. Зато швов меньше, и уход за таким санузлом проще. Укладка крупноформатного керамогранита — от 1 500 ₽/м².",
  },
  {
    q: "Можно купить только материал, без укладки?",
    a: "Да. Расчёт количества с подрезкой сделаем в любом случае — это бесплатно и ни к чему не обязывает.",
  },
];
---

<Base
  title="Плитка и керамогранит в Ижевске с укладкой — «Мой ремонт»"
  description="2 650 позиций плитки и керамогранита в наличии и под заказ. Расчёт количества с подрезкой за 2 минуты, бесплатный замер, дизайн-проект санузла в подарок."
>
  <Header cta="#lead" />

  <main>
    <Hero
      cover="/img/cover-bath.webp"
      eyebrow="бесплатный подбор · замер · раскладка"
      title="Плитка и керамогранит"
      titleTail="— по цене, которую назовёте вы"
      lead="Назовите бюджет — дизайнер бесплатно подберёт три варианта раскладки санузла с расчётом количества и подрезкой. Замер и консультация — 0 ₽."
      gift="Дизайн-проект санузла в подарок при заказе материала у нас"
      facts={[
        { value: "2 650", label: "позиций в наличии и под заказ" },
        { value: "30+", label: "дизайн-проектов санузлов" },
        { value: "0 ₽", label: "замер, расчёт и консультация" },
        { value: "3 месяца", label: "бесплатно храним материал" },
      ]}
    />

    <PriceList
      title="Скачайте <b>прайс-лист на плитку и керамогранит</b> в 1 клик"
      lead="Цены на все позиции со склада и под заказ. Пришлём туда, где вам удобно."
    />

    <Quiz
      direction="plitka"
      title="Посчитайте, сколько плитки нужно"
      accent="и получите дизайн-проект в подарок"
      personNote="Считаем стены и пол по вашей площади, а цены берём из каталога, а не «в среднем по рынку». Если ответ неочевиден — выберите «не знаю», уточним на замере."
    />

    <Steps title="Как мы отделываем санузел" steps={steps} />

    <Showcase
      direction="plitka"
      catalog="/catalog-plitka"
      eyebrow="со склада и под заказ"
      title="Плитка и керамогранит в наличии"
      lead="Показаны позиции со склада. В каталоге больше двух с половиной тысяч коллекций: подберём под раскладку и бюджет на замере."
    />

    {/* Чуть выше середины страницы — так просил заказчик (ответ 13) */}
    <Magnet
      title="12 ошибок при выборе плитки для санузла"
      lead="Из-за них переделывают ремонт и переплачивают до 40 000 ₽ — разбор с чек-листом расчёта количества."
      magnet="tile-mistakes"
      bullets={MAGNET_BULLETS}
    />

    <PriceList
      title="Нет времени изучать каталог? <b>Скачайте прайс с актуальными ценами</b> прямо сейчас"
      lead="Весь ассортимент плитки и керамогранита одним файлом — с ценами на сегодня."
      updated
    />

    <Payment />

    <Offers
      direction="plitka"
      title="Три способа сделать санузел выгоднее"
      lead="Подарки суммируются с ценой каталога: это не «скидка вместо скидки», а работы и услуги, за которые обычно платят отдельно."
    />

    <About />

    <Consult />

    <Contacts />

    <Faq items={faq} />
  </main>

  <Footer />

  <QuickForm />

  <ExitPopup
    title="Смета-образец: сколько стоит отделка санузла 4 м² в Ижевске"
    lead="Реальные цены на материал и работы за 2026 год — чтобы вы понимали бюджет до того, как звонить."
    magnet="bath-estimate"
    bullets={EXIT_BULLETS}
  />
</Base>
