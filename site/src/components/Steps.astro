---
/**
 * Этапы работы. Визуал по ТЗ (п. 4): тёмная секция, ячейки без заливки,
 * разделённые волосяной линией; номер шага — справа сверху, описание прижато
 * к низу ячейки. Это единственное место, где номера уместны: у этапов
 * порядок и правда несёт смысл — сначала замер, потом укладка.
 */
import SectionIntro from "./SectionIntro.astro";

interface Props {
  title: string;
  steps: { title: string; text: string; free?: boolean }[];
}

const { title, steps } = Astro.props;
---

<section class="steps on-dark">
  <div class="layout">
    <SectionIntro
      eyebrow="от идеи до готового пола"
      title={title}
      lead="Материал, замер, доставка и укладка — в одних руках. Не нужно искать бригаду отдельно."
    />

    {steps.map((step, i) => (
      <article class="steps__item">
        <div class="steps__head">
          <h3 class="steps__title">{step.title}</h3>
          <p class="steps__num num">/{i + 1}</p>
        </div>

        <div class="steps__foot">
          {step.free && <p class="steps__free">бесплатно</p>}
          <p class="steps__text">{step.text}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .steps { padding-block: var(--s-8); }

  /* Плитки тут без заливки: на тёмном фоне белые карточки развалили бы секцию
     на острова. Держит сетку волосяная линия по краю ячейки. */
  .steps__item {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-8);
    min-height: 230px;
    padding: var(--s-4);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .steps__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
  }

  .steps__title { font-size: var(--t-h3); }
  .steps__num { font-size: var(--t-h3); color: var(--ink-2); }
  .steps__text { font-size: var(--t-small); color: var(--ink-2); }

  .steps__free {
    display: inline-block;
    margin-bottom: var(--s-2);
    padding: 2px var(--s-1);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (min-width: 720px) {
    .steps__item { grid-column: span 6; }
  }

  @media (min-width: 1024px) {
    .steps__item { grid-column: span 4; }
  }
</style>
