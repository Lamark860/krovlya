---
/**
 * Блок обратной связи. По ТЗ (п. 11) заменяет прежнюю форму замера:
 * фон-фотография, менеджер справа, выпадающий список «когда позвонить»,
 * телефон и кнопка «Получить консультацию».
 *
 * Время звонка уезжает в поле `source` — в уведомлении о заявке оно приходит
 * строкой «Детали: перезвонить в течение часа». Отдельной колонки в базе
 * не заводим: это подсказка менеджеру, а не то, по чему будут строить отчёты.
 */
import Consent from "./Consent.astro";
import FormHiddens from "./FormHiddens.astro";
import Person from "./Person.astro";
import { company } from "../data/company";

interface Props {
  id?: string;
}

const { id = "lead" } = Astro.props;

const WHEN = [
  "Сейчас",
  "В течение часа",
  "В течение дня",
  "На этой неделе",
];
---

<section class="consult on-dark" id={id}>
  <img class="consult__bg" src="/img/consult-bg.webp" alt="" loading="lazy" width="1200" height="960" />

  <div class="layout consult__layout">
    <div class="consult__text">
      <p class="eyebrow">остались вопросы?</p>
      <h2>Проконсультируем и подберём покрытие с указанием наличия и сроков поставки</h2>
      <p class="lead">
        Расскажем, что подойдёт под вашу нагрузку и бюджет, и посчитаем стоимость пола
        вместе с укладкой. Звонок ни к чему не обязывает.
      </p>

      <form class="consult__form" data-lead data-channel="phone"
            data-analytics-form="lead" data-form-id="footer_form"
            data-placement="footer" data-lead-type="consultation">
        <label class="field consult__field">
          <span class="field__label">В какое время вам позвонить?</span>
          <select class="control" name="source">
            {WHEN.map((when) => <option value={`Перезвонить: ${when.toLowerCase()}`}>{when}</option>)}
          </select>
        </label>

        <label class="field consult__field">
          <span class="field__label" data-contact-label>Ваш номер телефона</span>
          <input name="contact" required inputmode="tel" data-contact placeholder="+7 " />
        </label>

        <button class="btn consult__submit" type="submit">Получить консультацию</button>

        {/* Без `source`: его роль здесь играет выпадающий список времени звонка */}
        <FormHiddens />
        <div class="consult__consent"><Consent /></div>
        <p class="form-error" data-error hidden></p>
      </form>

      <p class="consult__phone">
        Или сразу позвоните: <a class="phone" href={`tel:${company.phoneHref}`}
           data-analytics="phone" data-placement="consult">{company.phone}</a><br />
        <span class="muted">{company.showroom.hours}</span>
      </p>
    </div>

    <div class="consult__person">
      <Person badge="Онлайн, отвечаем за 15 минут" />
    </div>
  </div>
</section>

<script>
  import "../scripts/leadForms";
</script>

<style>
  .consult {
    position: relative;
    padding-block: var(--s-8);
    overflow: hidden;
  }

  .consult__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .consult::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgb(9 37 50 / 0.95) 0%, rgb(9 37 50 / 0.86) 55%, rgb(9 37 50 / 0.6) 100%);
  }

  .consult__layout { position: relative; z-index: 1; align-items: end; }

  .consult__text {
    grid-column: span 12;
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .consult__form { display: grid; gap: var(--s-2); width: 100%; margin-top: var(--s-2); }
  .consult__consent { max-width: 46ch; }
  .consult__phone { margin-top: var(--s-2); font-size: var(--t-small); }
  .consult__phone a { font-weight: 500; }

  /* Фото менеджера — не иллюстрация, а подпись под обещанием «отвечаем за
     15 минут»: обещание с лицом рядом читается как чьё-то, а не ничьё.
     На телефоне прячем: там первым делом нужна форма, а не портрет. */
  .consult__person { display: none; }

  @media (min-width: 900px) {
    .consult__text { grid-column: span 7; }
    .consult__form { grid-template-columns: 1fr 1fr; max-width: 640px; }
    .consult__submit,
    .consult__consent,
    .consult__form .form-error { grid-column: span 2; }

    .consult__person {
      grid-column: span 5;
      display: flex;
      justify-content: center;
      align-self: end;
    }

    .consult__person :global(.person) { width: 100%; max-width: 360px; }
  }
</style>
